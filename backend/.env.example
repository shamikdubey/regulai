# RegulAI v4 — Environment Variables
# Copy to .env — NEVER commit .env to git
ENVIRONMENT=production
DOMAIN=app.regulai.io
POSTGRES_OWNER_PASSWORD=
POSTGRES_APP_PASSWORD=
REDIS_PASSWORD=
ANTHROPIC_API_KEY=sk-ant-api03-...
OPENAI_API_KEY=sk-proj-...
SECRET_KEY=
AUTH0_DOMAIN=
AUTH0_API_AUDIENCE=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
SENTRY_DSN=

# ── Phase 2: Celery
ENABLE_CELERY=true              # Enable background AI jobs (requires celery_worker)
ENABLE_STREAMING=true           # Enable SSE streaming for queries
FLOWER_USER=admin               # Celery monitoring UI credentials
FLOWER_PASSWORD=

# ── Phase 3: GDPR/Privacy
# No extra env vars needed — GDPR endpoints use existing auth

# ── Phase 4: Observability
OTEL_ENDPOINT=http://otel-collector:4318/v1/traces   # OpenTelemetry endpoint
SENTRY_DSN=https://xxx@sentry.io/xxx                  # Error tracking

# ── Phase 5: Email (AWS SES)
SES_FROM_EMAIL=noreply@regulai.app
SES_REGION=ap-south-1

# ── Phase 5: Stripe Billing
ENABLE_BILLING=true
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Create these price IDs in your Stripe dashboard:
# STRIPE_PRICE_STARTER=price_starter_monthly
# STRIPE_PRICE_GROWTH=price_growth_monthly
# STRIPE_PRICE_BUSINESS=price_business_monthly
