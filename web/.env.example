# ── Web app environment variables ──────────────────────────────────────────
# Copy to .env and fill in values

# API base URL (leave empty to use Vite proxy in dev, or set production URL)
VITE_API_URL=

# App version (displayed in UI)
VITE_APP_VERSION=4.0.0

# Auth0 (Phase 1 — set when Auth0 is configured)
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=
