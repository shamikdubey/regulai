# ── Stage 1: Build the React SPA ────────────────────────────────────────────
FROM node:22-alpine AS builder

WORKDIR /app

# Install deps first (layer cached unless package.json changes)
COPY package.json ./
RUN npm install --frozen-lockfile --ignore-scripts

# Copy source
COPY . .

# Build for production (TypeScript check + Vite build)
RUN npm run build

# ── Stage 2: Serve with Nginx ────────────────────────────────────────────────
FROM nginx:1.27-alpine AS production

# Remove default Nginx config
RUN rm -f /etc/nginx/conf.d/default.conf

# Copy built app to Nginx web root
COPY --from=builder /app/dist /usr/share/nginx/html

# Nginx config is mounted as a volume in docker-compose
# (so it can be updated without rebuilding the image)

# Add non-root user for Nginx worker processes
RUN adduser -D -H -u 1001 -s /sbin/nologin www-data-app || true
RUN chown -R nginx:nginx /usr/share/nginx/html

EXPOSE 80 443

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD wget -qO- http://localhost/health || exit 1

CMD ["nginx", "-g", "daemon off;"]
